name: CI

on:
  push:
    branches: [main]
  pull_request:

# Least privilege by default; jobs widen it only where needed.
permissions:
  contents: read

# A new push to the same branch cancels the run it supersedes.
concurrency:
{%- raw %}
  group: ${{ github.workflow }}-${{ github.ref }}
{%- endraw %}
  cancel-in-progress: true

jobs:
  pre-commit:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: astral-sh/setup-uv@v6
      - uses: actions/cache@v4
        with:
          path: ~/.cache/pre-commit
{%- raw %}
          key: pre-commit-${{ hashFiles('.pre-commit-config.yaml') }}
{%- endraw %}
      # Same hooks as local commits, so a machine without hooks installed can't bypass them.
      - run: uvx pre-commit run --all-files --show-diff-on-failure
{%- if 'python' in languages %}

  python:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: astral-sh/setup-uv@v6
      # --locked fails if uv.lock is out of date with pyproject.toml instead of silently updating it.
      - run: uv sync --locked
      - run: uv run pytest
{%- endif %}
{%- if 'c' in languages %}

  c:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - run: sudo apt-get update && sudo apt-get install -y ninja-build clang-tidy
{%- if c_test_framework == 'criterion' %} libcriterion-dev{% endif %}
      # Warnings are errors only in CI, so a newer local compiler can't block your build.
      - run: cmake --workflow --preset ci
      - run: cmake --workflow --preset asan
      - run: cmake --workflow --preset lint
{%- endif %}
{%- if profile == 'project' %}

  # Squash-merge turns the PR title into the commit on main, so the title must be a
  # Conventional Commit too: it's what release tooling and the changelog read.
  pr-title:
    if: github.event_name == 'pull_request'
    runs-on: ubuntu-latest
    permissions:
      pull-requests: read
    steps:
      - uses: amannn/action-semantic-pull-request@v5
        env:
{%- raw %}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}
{%- endraw %}
{%- endif %}
