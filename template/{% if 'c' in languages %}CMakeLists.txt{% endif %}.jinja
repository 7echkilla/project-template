cmake_minimum_required(VERSION 3.25)
project({{ package_name }} VERSION 0.1.0 LANGUAGES C)

set(CMAKE_C_STANDARD {{ c_standard }})
set(CMAKE_C_STANDARD_REQUIRED ON)
set(CMAKE_C_EXTENSIONS OFF)

add_library({{ package_name }} src/{{ package_name }}.c)
target_include_directories({{ package_name }} PUBLIC include)
target_compile_options({{ package_name }} PRIVATE -Wall -Wextra -Wpedantic)

add_executable({{ package_name }}_app src/main.c)
set_target_properties({{ package_name }}_app PROPERTIES OUTPUT_NAME {{ project_slug }})
target_link_libraries({{ package_name }}_app PRIVATE {{ package_name }})
target_compile_options({{ package_name }}_app PRIVATE -Wall -Wextra -Wpedantic)

{%- if c_test_framework != 'none' %}

enable_testing()
add_subdirectory(tests)
{%- endif %}
