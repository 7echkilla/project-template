[project]
name = "{{ project_slug }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
{%- if license != 'none' %}
license = "{{ license_spdx }}"
license-files = ["LICENSE"{% if license == 'lgpl-3.0' %}, "COPYING"{% endif %}]
{%- endif %}
dependencies = []

[build-system]
# Patch updates allowed, next minor blocked (as `uv init` writes it). Dependabot can't read this
# .jinja file, so bump by hand; generated projects then keep it current themselves.
requires = ["uv_build>=0.13.7,<0.14.0"]
build-backend = "uv_build"

[dependency-groups]
dev = [
    "pytest>=9",
    "pyright>=1.1.414",
    "ruff>=0.17.2"
]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B"]

[tool.pyright]
include = ["src", "tests"]
typeCheckingMode = "standard"

[tool.pytest.ini_options]
testpaths = ["tests"]
